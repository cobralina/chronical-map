{
  "version": 8,
  "name": "Mideast PMTiles Basemap Light",
  "sources": {
    "combined-pmtiles": {
      "type": "vector",
      "url": "pmtiles:///mideast_combined.pmtiles"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#c4d8dd"
      }
    },
    {
      "id": "pmtiles-land-fill",
      "type": "fill",
      "source": "combined-pmtiles",
      "source-layer": "land",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#EAEAEC",
        "fill-opacity": 0.95
      }
    },
    {
      "id": "pmtiles-land-line",
